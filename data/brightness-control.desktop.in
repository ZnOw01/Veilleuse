[Desktop Entry]
Version=1.0
Type=Application
Name=Brillo
GenericName=Control de brillo de pantalla
Comment=Ajusta el brillo del panel de forma gradual y segura
Exec="@BRIGHTNESS_EXEC@"
Icon=brightness-control
Terminal=false
Categories=Settings;
Keywords=brightness;backlight;screen;brillo;pantalla;luz;
StartupNotify=true
StartupWMClass=com.snowflake.Brightness
X-GNOME-UsesNotifications=true
