#!/usr/bin/python3
"""Native control helper for the Veilleuse Omarchy 4 plugin.

Reads and writes display brightness and the hyprsunset night light through the
same Omarchy surfaces the shell itself uses (``omarchy-monitor-state``,
``omarchy-brightness-display --no-osd --monitor`` and ``hyprctl hyprsunset``),
and atomically reads/writes the hyprsunset schedule with the conservative
``src/schedule_utils`` parser when it ships with the plugin.

This helper is deliberately stdlib-only, never uses ``shell=True`` and never
manages services: starting, enabling or restarting hyprsunset is Omarchy's
job, not the plugin's.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
import types
import shutil
from pathlib import Path

COMMAND_TIMEOUT = 1.0
WRITE_TIMEOUT = 2.0
READBACK_TOLERANCE_TEMP = 50
READBACK_TOLERANCE_GAMMA = 1
READBACK_TOLERANCE_BRIGHTNESS = 1
POLL_INTERVAL = 0.05
DEADLINE_EXIT_CODE = 124

BRIGHTNESS_MIN = 1
BRIGHTNESS_MAX = 100
TEMPERATURE_MIN = 2500
TEMPERATURE_MAX = 6500
GAMMA_MIN = 0
GAMMA_MAX = 100
IDENTITY_TEMPERATURE = 6000
# Temperatures at or above this are "day" light (schedule_utils.DAY_TEMP_MIN):
# reading one must not report the night light as enabled, otherwise status
# inverts during a warm day and toggle_nightlight disables the schedule.
DAY_TEMPERATURE_THRESHOLD = 5900
DEFAULT_TEMP = 3500

PLUGIN_ID = "io.github.znow01.veilleuse"

MONITOR_STATE_COMMAND = ("omarchy-monitor-state",)
BRIGHTNESS_COMMAND = ("omarchy-brightness-display", "--no-osd", "--monitor")
HYPRSUNSET_COMMAND = ("hyprctl", "hyprsunset")

_PERCENT_PATTERN = re.compile(r"\s*([0-9]{1,3})\s*")
_INTEGER_PATTERN = re.compile(r"\s*([0-9]+)\s*")
_SCHEDULE_MODULE_CACHE = {}
_SHORTCUT_MODULE_CACHE = {}
_STATE_MODULE_CACHE = {}
_UTILITY_MODULE_CACHE = {}


# --------------------------------------------------------------------------- \
# self location

def resolve_plugin_root() -> Path:
    """Return the installed plugin directory containing this helper.

    The plugin keeps its manifest at the root and the helper under
    ``scripts/``, so the installed layout is the same whether the plugin was
    cloned into ``~/.config/omarchy/plugins/<id>`` by ``omarchy plugin add``
    or checked out as a development worktree.
    """
    helper = Path(os.path.abspath(__file__)).resolve()
    root = helper.parent.parent
    if not (root / "manifest.json").is_file():
        raise RuntimeError(
            f"No se encontró manifest.json en {root}; el helper debe vivir en scripts/ del plugin"
        )
    return root


def _report_module_load_failure(path: Path, caught: BaseException) -> None:
    """Surface a genuine module load failure instead of hiding it.

    A missing sibling module is a normal degraded install, but a syntax
    error or a bug inside one of the helpers must be diagnosable: without
    this report every failure looks like an unexplained
    ``helper_unavailable``.
    """
    print(
        f"veilleuse: no se pudo cargar {path.name}: {caught}",
        file=sys.stderr,
    )


def _schedule_module():
    """Import the shared conservative parser when it is part of the plugin."""
    root = resolve_plugin_root()
    source = root / "scripts"
    path = source / "schedule_utils.py"
    if path.is_file():
        cached = _SCHEDULE_MODULE_CACHE.get(path)
        if cached is not None:
            return cached
        try:
            module = types.ModuleType("schedule_utils")
            module.__file__ = str(path)
            code = compile(path.read_text(encoding="utf-8"), str(path), "exec")
            exec(code, module.__dict__)
            _SCHEDULE_MODULE_CACHE[path] = module
            return module
        except Exception as caught:
            _report_module_load_failure(path, caught)
            return None
    return None


def _shortcut_module():
    """Import the reversible shortcut manager when it ships with the plugin."""
    root = resolve_plugin_root()
    path = root / "scripts" / "shortcut_utils.py"
    if path.is_file():
        cached = _SHORTCUT_MODULE_CACHE.get(path)
        if cached is not None:
            return cached
        try:
            module = types.ModuleType("shortcut_utils")
            module.__file__ = str(path)
            code = compile(path.read_text(encoding="utf-8"), str(path), "exec")
            exec(code, module.__dict__)
            _SHORTCUT_MODULE_CACHE[path] = module
            return module
        except Exception as caught:
            _report_module_load_failure(path, caught)
            return None
    return None


def _state_module():
    """Load the safe XDG persistence module without creating bytecode files."""
    root = resolve_plugin_root()
    path = root / "scripts" / "state_utils.py"
    if path.is_file():
        cached = _STATE_MODULE_CACHE.get(path)
        if cached is not None:
            return cached
        try:
            module = types.ModuleType("state_utils")
            module.__file__ = str(path)
            code = compile(path.read_text(encoding="utf-8"), str(path), "exec")
            exec(code, module.__dict__)
            _STATE_MODULE_CACHE[path] = module
            return module
        except Exception as caught:
            _report_module_load_failure(path, caught)
            return None
    return None


def _utility_module(name):
    """Load one existing utility module without creating package bytecode."""
    root = resolve_plugin_root()
    path = root / "scripts" / f"{name}.py"
    cache_key = (path, str(os.environ.get("XDG_CONFIG_HOME", "")), str(os.environ.get("XDG_STATE_HOME", "")))
    cached = _UTILITY_MODULE_CACHE.get((name, cache_key))
    if cached is not None:
        if name == "schedule_toggle_utils":
            cached.HYPRSUNSET_CONFIG = config_path()
        return cached
    if not path.is_file():
        return None
    try:
        source = root / "scripts"
        package = sys.modules.get("scripts")
        if package is None:
            package = types.ModuleType("scripts")
            package.__path__ = [str(source)]
            sys.modules["scripts"] = package
        state = _state_module()
        if state is not None:
            sys.modules["scripts.state_utils"] = state
            sys.modules["state_utils"] = state
        schedule = _schedule_module()
        if schedule is not None:
            sys.modules["schedule_utils"] = schedule
        module = types.ModuleType(name)
        module.__file__ = str(path)
        code = compile(path.read_text(encoding="utf-8"), str(path), "exec")
        exec(code, module.__dict__)
        _UTILITY_MODULE_CACHE[(name, cache_key)] = module
        if name == "schedule_toggle_utils":
            module.HYPRSUNSET_CONFIG = config_path()
        return module
    except Exception as caught:
        _report_module_load_failure(path, caught)
        return None


def config_path() -> Path:
    """Path of the user hyprsunset schedule, honoring XDG_CONFIG_HOME."""
    base = os.environ.get("XDG_CONFIG_HOME", "")
    config_home = (
        Path(base).expanduser()
        if base and Path(base).expanduser().is_absolute()
        else Path.home() / ".config"
    )
    return config_home / "hypr" / "hyprsunset.conf"


# --------------------------------------------------------------------------- \
# bounded subprocess

def run_command(args, *, timeout=COMMAND_TIMEOUT):
    """Run one command array without a shell under a bounded timeout."""
    try:
        return subprocess.run(
            list(args),
            text=True,
            capture_output=True,
            check=False,
            timeout=float(timeout),
        )
    except subprocess.TimeoutExpired as error:
        result = subprocess.CompletedProcess(
            list(args), DEADLINE_EXIT_CODE, _text(error.stdout), _text(error.stderr) or str(error)
        )
        result._veilleuse_error_kind = "timeout"
        return result
    except FileNotFoundError as error:
        result = subprocess.CompletedProcess(list(args), 127, "", str(error))
        result._veilleuse_error_kind = "missing_command"
        return result
    except OSError as error:
        result = subprocess.CompletedProcess(list(args), 127, "", str(error))
        result._veilleuse_error_kind = "os_error"
        return result


def _text(value) -> str:
    if value is None:
        return ""
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    return str(value)


def _int_or_none(output) -> int | None:
    match = _INTEGER_PATTERN.fullmatch(_text(output))
    return int(match.group(1)) if match else None


def _percent_or_none(output) -> int | None:
    match = _PERCENT_PATTERN.fullmatch(_text(output))
    if match is None:
        return None
    percent = int(match.group(1))
    return percent if BRIGHTNESS_MIN <= percent <= BRIGHTNESS_MAX else None


# --------------------------------------------------------------------------- \
# monitor state

def read_monitor_state():
    """Run omarchy-monitor-state and parse the shell's monitor summary.

    The command prints, one per line: focused brightness, internal monitor,
    external monitor, active internal, mirror, focused monitor, scaling and a
    JSON array of monitors.  Lines may be empty when a value is unknown.
    """
    result = run_command(MONITOR_STATE_COMMAND)
    if result.returncode != 0:
        return {
            "brightness": None,
            "monitor": None,
            "internal": None,
            "external": None,
            "monitors": [],
        }
    lines = _text(result.stdout).splitlines()
    while len(lines) < 8:
        lines.append("")
    return {
        "brightness": _percent_or_none(lines[0]),
        "monitor": lines[5].strip() or None,
        "internal": lines[1].strip() or None,
        "external": lines[2].strip() or None,
        "monitors": _parse_monitors_json(lines[7]),
    }


def _parse_monitors_json(text):
    if not text.strip():
        return []
    try:
        data = json.loads(text)
    except (ValueError, TypeError):
        return []
    if not isinstance(data, list):
        return []
    result = []
    for entry in data:
        if not isinstance(entry, dict):
            continue
        name = entry.get("name")
        enabled_value = entry.get("enabled")
        disabled_value = entry.get("disabled", False)
        focused_value = entry.get("focused", False)
        if (
            not isinstance(name, str)
            or not name.strip()
            or not isinstance(enabled_value, bool)
            or not isinstance(disabled_value, bool)
            or not isinstance(focused_value, bool)
        ):
            continue
        result.append(
            {
                "name": name,
                "enabled": enabled_value and not disabled_value,
                "focused": focused_value,
            }
        )
    return result


def read_brightness(monitor):
    """Read the current brightness percentage of one monitor."""
    if not monitor:
        return None, "No se pudo resolver un monitor enfocado"
    result = run_command([*BRIGHTNESS_COMMAND, monitor])
    if result.returncode != 0:
        return None, (result.stderr.strip() or "No se pudo leer el brillo")
    percent = _percent_or_none(result.stdout)
    if percent is None:
        return None, "Salida de brillo no reconocida"
    return percent, None


def _monitor_write_error(monitor, target="focused"):
    state = read_monitor_state()
    matches = [entry for entry in state["monitors"] if entry["name"] == monitor]
    if not matches or not matches[0]["enabled"]:
        return "El monitor seleccionado no está habilitado"
    if target == "focused":
        if state["monitor"] != monitor:
            return "El monitor enfocado no es coherente con el estado actual"
        if not matches[0]["focused"]:
            return "El monitor enfocado no es coherente con la lista de monitores"
    return None


def _resolve_monitor_target(target, state=None):
    state = read_monitor_state() if state is None else state
    if target == "focused":
        monitor = state.get("monitor")
        error = _monitor_write_error(monitor, "focused") if monitor else "No se pudo resolver un monitor enfocado"
        return monitor, error
    if not isinstance(target, str) or not target:
        return None, "El monitor seleccionado no está habilitado"
    matches = [entry for entry in state.get("monitors", []) if entry.get("name") == target]
    if len(matches) != 1 or matches[0].get("enabled") is not True:
        return None, "El monitor seleccionado no está habilitado"
    return target, None


def apply_brightness(monitor, target):
    """Apply an absolute brightness percentage and confirm the readback.

    The requested slider value is written as one absolute ``N%`` token — the
    surface omarchy-brightness-display documents alongside its relative
    steps — and the helper polls until the physical readback lands within
    one point of the target.  One write reaches the destination, so a drag
    never leaves a chain of one-point steps running after the release.
    """
    target = max(BRIGHTNESS_MIN, min(BRIGHTNESS_MAX, int(target)))
    if not monitor:
        return {
            "available": False,
            "percent": None,
            "monitor": None,
            "error": "No se pudo resolver un monitor enfocado",
        }
    monitor_error = _monitor_write_error(
        monitor, "focused" if monitor == read_monitor_state().get("monitor") else "explicit"
    )
    if monitor_error is not None:
        return {
            "available": False,
            "percent": None,
            "monitor": monitor,
            "error": monitor_error,
        }
    before, error = read_brightness(monitor)
    if before is None:
        return {"available": False, "percent": None, "monitor": monitor, "error": error}
    if target == before:
        return {"available": True, "percent": before, "monitor": monitor, "error": None}
    result = run_command([*BRIGHTNESS_COMMAND, monitor, f"{target}%"], timeout=WRITE_TIMEOUT)
    if result.returncode != 0:
        return {
            "available": False,
            "percent": before,
            "monitor": monitor,
            "error": result.stderr.strip() or "No se pudo cambiar el brillo",
        }
    deadline = time.monotonic() + WRITE_TIMEOUT
    while True:
        percent, error = read_brightness(monitor)
        if percent is not None and abs(percent - target) <= READBACK_TOLERANCE_BRIGHTNESS:
            return {"available": True, "percent": percent, "monitor": monitor, "error": None}
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return {
                "available": percent is not None,
                "percent": percent,
                "monitor": monitor,
                "error": error or "El cambio de brillo no se confirmó",
            }
        time.sleep(min(POLL_INTERVAL, remaining))


# --------------------------------------------------------------------------- \
# hyprsunset night light


def _nightlight_state(error=None):
    return {
        "available": False,
        "enabled": False,
        "temperature": None,
        "identity": None,
        "gamma": None,
        "error": error,
    }


def _nightlight_command_error(result):
    kind = getattr(result, "_veilleuse_error_kind", None)
    stderr = _text(result.stderr).strip()
    if kind == "missing_command" or (
        result.returncode == 127
        and re.search(r"no such file|not found", stderr, re.IGNORECASE)
    ):
        return "Comando ausente: hyprctl"
    if kind == "timeout" or result.returncode == DEADLINE_EXIT_CODE:
        return "Tiempo de espera agotado al consultar hyprsunset"
    detail = f": {stderr}" if stderr else ""
    return f"hyprsunset no disponible{detail}"

def read_nightlight(*, deadline=None):
    """Read identity, temperature and gamma through the hyprsunset IPC."""
    results = {}
    queries = (
        ("identity", [*HYPRSUNSET_COMMAND, "identity", "get"]),
        ("temperature", [*HYPRSUNSET_COMMAND, "temperature"]),
        ("gamma", [*HYPRSUNSET_COMMAND, "gamma"]),
    )
    for name, command in queries:
        timeout = COMMAND_TIMEOUT
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return _nightlight_state("Tiempo de espera agotado al consultar hyprsunset")
            timeout = min(COMMAND_TIMEOUT, remaining)
        result = run_command(command, timeout=timeout)
        results[name] = result
        if result.returncode != 0:
            return _nightlight_state(_nightlight_command_error(result))

    identity_result = results["identity"]
    temperature_result = results["temperature"]
    gamma_result = results["gamma"]

    identity_value = _text(identity_result.stdout).strip().casefold()
    identity = None
    if identity_result.returncode == 0 and identity_value in {"true", "false"}:
        identity = identity_value == "true"
    temperature_value = (
        _int_or_none(temperature_result.stdout)
        if temperature_result.returncode == 0
        else None
    )
    temperature = (
        temperature_value
        if temperature_value is not None
        and TEMPERATURE_MIN <= temperature_value <= TEMPERATURE_MAX
        else None
    )
    gamma_value = _int_or_none(gamma_result.stdout) if gamma_result.returncode == 0 else None
    gamma = None
    if gamma_value is not None and GAMMA_MIN <= gamma_value <= GAMMA_MAX:
        gamma = gamma_value

    available = identity is not None and temperature is not None and gamma is not None
    if not available:
        return _nightlight_state("Respuesta de hyprsunset no reconocida")
    elif identity is True:
        enabled = False
    else:
        enabled = temperature < DAY_TEMPERATURE_THRESHOLD
    return {
        "available": available,
        "enabled": enabled,
        "temperature": temperature,
        "identity": identity,
        "gamma": gamma,
        "error": None,
    }


def _wait_readback(predicate, deadline, failure_message):
    """Poll a readback predicate until it holds or the deadline expires."""
    while True:
        state = read_nightlight(deadline=deadline)
        if predicate(state):
            return state
        if state["error"]:
            return state
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            state["error"] = failure_message
            return state
        time.sleep(min(POLL_INTERVAL, remaining))


def _apply_temperature(kelvin):
    target = max(TEMPERATURE_MIN, min(TEMPERATURE_MAX, int(kelvin)))
    result = run_command([*HYPRSUNSET_COMMAND, "temperature", str(target)], timeout=WRITE_TIMEOUT)
    if result.returncode != 0:
        return _nightlight_failure(result.stderr.strip() or "No se pudo aplicar la temperatura")
    deadline = time.monotonic() + WRITE_TIMEOUT
    state = _wait_readback(
        lambda current: (
            current["temperature"] is not None
            and abs(current["temperature"] - target) <= READBACK_TOLERANCE_TEMP
        ),
        deadline,
        "La temperatura aplicada no coincide con la solicitud",
    )
    return state


def _apply_natural():
    result = run_command([*HYPRSUNSET_COMMAND, "identity"], timeout=WRITE_TIMEOUT)
    if result.returncode != 0:
        return _nightlight_failure(result.stderr.strip() or "No se pudo aplicar el color natural")
    deadline = time.monotonic() + WRITE_TIMEOUT
    state = _wait_readback(
        lambda current: current["identity"] is True,
        deadline,
        "El color natural no se confirmó",
    )
    return state


def _apply_gamma(percent):
    target = max(GAMMA_MIN, min(GAMMA_MAX, int(percent)))
    result = run_command([*HYPRSUNSET_COMMAND, "gamma", str(target)], timeout=WRITE_TIMEOUT)
    if result.returncode != 0:
        return _nightlight_failure(result.stderr.strip() or "No se pudo aplicar el brillo percibido")
    deadline = time.monotonic() + WRITE_TIMEOUT
    state = _wait_readback(
        lambda current: (
            current["gamma"] is not None
            and abs(current["gamma"] - target) <= READBACK_TOLERANCE_GAMMA
        ),
        deadline,
        "El brillo percibido aplicado no coincide con la solicitud",
    )
    return state


def _nightlight_failure(message):
    state = read_nightlight()
    if state["error"]:
        state["error"] = f"{message}: {state['error']}"
    else:
        state["error"] = message
    return state


def toggle_nightlight():
    """Toggle between warm light and natural color using observed state."""
    current = read_nightlight()
    if not current["available"]:
        return _nightlight_failure("La luz nocturna no está disponible")
    if current["enabled"] is True and not current["identity"]:
        return _apply_natural()
    # Currently natural or reading stale: apply a warm temperature.  A
    # temperature register that still holds a non-warm value is unreliable
    # while identity was active, so fall back to the default warm selection.
    temperature = current["temperature"] or DEFAULT_TEMP
    if not (TEMPERATURE_MIN <= temperature <= TEMPERATURE_MAX and temperature < DAY_TEMPERATURE_THRESHOLD):
        temperature = DEFAULT_TEMP
    return _apply_temperature(temperature)


# --------------------------------------------------------------------------- \
# schedule

_PROFILE_TIME_RE = re.compile(
    r"(?mi)^([ \t]*time\s*=\s*)[0-9]{1,2}:[0-9]{2}([ \t]*(?:#.*)?)(\r?)$"
)
_PROFILE_TEMP_RE = re.compile(
    r"(?mi)^([ \t]*)temperature\s*=\s*[^ \t\r\n{}#]+([ \t]*(?:#.*)?)(\r?)$"
)
_PROFILE_IDENTITY_RE = re.compile(
    r"(?mi)^([ \t]*)identity(?:[ \t]*=[ \t]*(?:true|false))?"
    r"([ \t]*(?:#.*)?)(\r?)$"
)


def _replace_time(profile, time_value):
    return _PROFILE_TIME_RE.sub(
        lambda match: match.group(1) + time_value + match.group(2) + match.group(3),
        profile,
        count=1,
    )


def _replace_temperature(profile, temperature):
    return _PROFILE_TEMP_RE.sub(
        lambda match: (
            match.group(1) + "temperature = " + str(temperature) + match.group(2) + match.group(3)
        ),
        profile,
        count=1,
    )


def _remove_temperature(profile):
    return _PROFILE_TEMP_RE.sub(
        lambda match: match.group(1) + match.group(2) + match.group(3)
        if "#" in match.group(2)
        else match.group(3),
        profile,
    )


def _set_identity(profile):
    if _PROFILE_IDENTITY_RE.search(profile):
        return _PROFILE_IDENTITY_RE.sub(
            lambda match: match.group(1) + "identity = true" + match.group(2) + match.group(3),
            profile,
            count=1,
        )
    line_ending = "\r\n" if "\r\n" in profile else "\n"
    return re.sub(
        r"\}\s*$",
        f"    identity = true{line_ending}}}",
        profile,
        count=1,
    )


def _remove_identity(profile):
    return _PROFILE_IDENTITY_RE.sub(
        lambda match: match.group(1) + match.group(2) + match.group(3)
        if "#" in match.group(2)
        else match.group(3),
        profile,
    )


def _update_profile(profile, time_value, temperature, identity_day):
    """Update one profile block without disturbing formatting or comments."""
    schedule_module = _schedule_module()
    info = schedule_module.profile_info(profile) if schedule_module else {}
    updated = _replace_time(profile, time_value)
    if identity_day:
        updated = _remove_temperature(updated)
        if info.get("identity") is not None:
            updated = _set_identity(updated)
        else:
            line_ending = "\r\n" if "\r\n" in updated else "\n"
            updated = re.sub(
                r"\}\s*$",
                f"    identity = true{line_ending}}}",
                updated,
                count=1,
            )
    elif info.get("temperature") is not None:
        updated = _replace_temperature(updated, temperature)
        updated = _remove_identity(updated)
    elif info.get("identity") is not None:
        updated = _remove_identity(updated)
        line_ending = "\r\n" if "\r\n" in updated else "\n"
        updated = re.sub(
            r"\}\s*$",
            f"    temperature = {temperature}{line_ending}}}",
            updated,
            count=1,
        )
    else:
        line_ending = "\r\n" if "\r\n" in updated else "\n"
        updated = re.sub(
            r"\}\s*$",
            f"    temperature = {temperature}{line_ending}}}",
            updated,
            count=1,
        )
    return updated


_OWNERSHIP_MARKER_RE = re.compile(
    r"(?im)^[ \t]*#[^\n]*\bveilleuse\b[^\n]*\b(day|night)\b[^\n]*$"
)


def _marker_comment(kind):
    return f"# Veilleuse {kind}\n"


def _block_has_marker(existing, start, kind):
    """True when an ownership marker of ``kind`` sits just above the block."""
    window = existing[max(0, start - 256):start]
    return any(
        match.group(1).casefold() == kind
        for match in _OWNERSHIP_MARKER_RE.finditer(window)
    )


def _render_schedule(schedule, natural_day):
    """Render a managed hyprsunset.conf when none exists yet.

    Each managed block carries an explicit ``# Veilleuse day/night`` marker
    so schedule toggling keeps working once the user adds unrelated profiles
    (ownership is only implicit while the file holds exactly two).
    """
    day_profile = (
        f"profile {{\n    time = {schedule['day_time']}\n    identity = true\n}}"
        if natural_day
        else f"profile {{\n    time = {schedule['day_time']}\n"
        f"    temperature = {schedule['day_temp']}\n}}"
    )
    return (
        f"# Generated by Veilleuse\n"
        f"# Times use the system timezone.\n"
        f"{_marker_comment('day')}"
        f"{day_profile}\n\n"
        f"{_marker_comment('night')}"
        f"profile {{\n    time = {schedule['night_time']}\n"
        f"    temperature = {schedule['night_temp']}\n}}\n"
    )


def _update_schedule_text(existing, schedule, natural_day):
    """Update the first day/night profiles, preserving every other block.

    Managed blocks also gain an explicit ``# Veilleuse day/night`` marker
    when they do not carry one yet, for the same reason as in
    :func:`_render_schedule`.
    """
    schedule_module = _schedule_module()
    replacements = []
    found_day = False
    found_night = False
    for start, end, profile in schedule_module.iter_profile_blocks(existing):
        info = schedule_module.profile_info(profile)
        if info["time"] is None:
            continue
        kind = schedule_module.profile_kind(info)
        if kind == "day" and not found_day:
            updated_profile = _update_profile(profile, schedule["day_time"], schedule["day_temp"], natural_day)
            if not _block_has_marker(existing, start, "day"):
                updated_profile = _marker_comment("day") + updated_profile
            replacements.append((start, end, updated_profile))
            found_day = True
        elif kind == "night" and not found_night:
            updated_profile = _update_profile(profile, schedule["night_time"], schedule["night_temp"], False)
            if not _block_has_marker(existing, start, "night"):
                updated_profile = _marker_comment("night") + updated_profile
            replacements.append((start, end, updated_profile))
            found_night = True

    updated = existing
    for start, end, replacement in reversed(replacements):
        updated = updated[:start] + replacement + updated[end:]

    missing = []
    if not found_day:
        day_block = (
            f"profile {{\n    time = {schedule['day_time']}\n    identity = true\n}}"
            if natural_day
            else f"profile {{\n    time = {schedule['day_time']}\n"
            f"    temperature = {schedule['day_temp']}\n}}"
        )
        missing.append(_marker_comment("day") + day_block)
    if not found_night:
        missing.append(
            _marker_comment("night")
            + f"profile {{\n    time = {schedule['night_time']}\n"
            f"    temperature = {schedule['night_temp']}\n}}"
        )
    if missing:
        separator = (
            ""
            if not updated or updated.endswith("\n\n")
            else ("\n" if updated.endswith("\n") else "\n\n")
        )
        updated += separator + "\n\n".join(missing) + "\n"
    return updated


def schedule_module_or_error():
    schedule_module = _schedule_module()
    if schedule_module is None:
        return None, "El parser de horario del plugin no está disponible"
    return schedule_module, None


def _paused_schedule_text():
    """Original schedule text stored by an active disable transaction.

    While the schedule is paused the managed profile blocks are removed from
    hyprsunset.conf by design, so a profile-less file is the expected state
    and its values live in the transaction, not in the file.
    """
    state = _state_module()
    if state is None:
        return None
    try:
        current = state.read_state()
    except Exception:
        return None
    transaction = current.get("schedule_disabled")
    if current.get("schedule_enabled") or not isinstance(transaction, dict):
        return None
    text = transaction.get("original_text")
    return text if isinstance(text, str) and text else None


def schedule_get():
    """Return the parsed schedule, its identity day flag and active period.

    A missing or empty config returns the parser's documented default
    template (06:00 / 6000 K day, 15:30 / 3500 K night) so status stays
    coherent before the user saves a first schedule.  A config stripped of
    its profiles by an active disable transaction reports the paused
    schedule from that transaction instead of failing as malformed.
    """
    schedule_module, error = schedule_module_or_error()
    if schedule_module is None:
        return _schedule_result(None, False, error)
    path = config_path()
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        text = ""
    except OSError as caught:
        return _schedule_result(None, False, str(caught))
    try:
        if not text.strip():
            schedule = schedule_module.default_schedule()
            day_identity = False
            period_value = schedule_module.schedule_period(schedule)
        else:
            schedule = schedule_module.parse_schedule_text(text, strict=True)
            day_identity = schedule_module.day_profile_is_identity(text)
            period_value = schedule_module.schedule_period(schedule)
    except ValueError as caught:
        paused = _paused_schedule_text()
        if paused is None:
            return _schedule_result(None, False, str(caught))
        try:
            schedule = schedule_module.parse_schedule_text(paused, strict=True)
            day_identity = schedule_module.day_profile_is_identity(paused)
            period_value = schedule_module.schedule_period(schedule)
        except ValueError:
            return _schedule_result(None, False, str(caught))
    return _schedule_result(schedule, day_identity, None, period_value)


def schedule_set(values):
    """Atomically update the schedule, preserving comments and permissions.

    The write reuses the safe ``schedule_utils`` primitives: it validates with
    ``validate_schedule``, updates only the first day/night profiles (keeping
    unrelated blocks, comments and formatting), preserves the original file
    mode, and writes atomically (temp file + ``os.replace``) under the shared
    exclusive lock with a ``.bak`` backup.  No service is started, enabled or
    restarted here.
    """
    schedule_module, error = schedule_module_or_error()
    if schedule_module is None:
        return _schedule_result(None, False, error)
    path = config_path()
    try:
        schedule = schedule_module.validate_schedule(
            {
                "day_time": values["day_time"],
                "day_temp": values["day_temp"],
                "night_time": values["night_time"],
                "night_temp": values["night_temp"],
            }
        )
        path.parent.mkdir(parents=True, exist_ok=True)
        with schedule_module.exclusive_lock(path.parent / schedule_module.SCHEDULE_LOCK_NAME):
            original_mode = path.stat().st_mode & 0o7777 if path.exists() else None
            if path.exists():
                existing = path.read_text(encoding="utf-8")
            else:
                existing = ""
            if existing:
                updated = _update_schedule_text(existing, schedule, values.get("natural_day", True))
                try:
                    schedule_module.parse_schedule_text(updated, strict=True)
                except ValueError as caught:
                    return _schedule_result(None, values.get("natural_day", True), str(caught))
            else:
                updated = _render_schedule(schedule, values.get("natural_day", True))
            if path.exists():
                schedule_module.atomic_write_text(
                    path.with_suffix(path.suffix + ".bak"), existing, original_mode
                )
            schedule_module.atomic_write_text(path, updated, original_mode)
    except (OSError, ValueError) as caught:
        return _schedule_result(None, values.get("natural_day", True), str(caught))
    return schedule_get()


def _schedule_result(schedule, day_identity, error, period_value=None):
    result = {
        "available": schedule is not None,
        "day_time": None,
        "day_temp": None,
        "night_time": None,
        "night_temp": None,
        "day_identity": bool(day_identity),
        "period": period_value,
        "error": error,
    }
    if schedule is not None:
        result.update(
            {
                "day_time": schedule.get("day_time"),
                "day_temp": schedule.get("day_temp"),
                "night_time": schedule.get("night_time"),
                "night_temp": schedule.get("night_temp"),
            }
        )
    return result


# --------------------------------------------------------------------------- \
# status + CLI

_PERSISTENCE_ERROR_MESSAGES = {
    "invalid_json": "Los datos guardados no tienen un formato válido",
    "invalid_schema": "El esquema de los datos guardados no es compatible",
    "invalid_config": "La configuración guardada no es válida",
    "invalid_state": "El estado guardado no es válido",
    "invalid_history": "El historial guardado no es válido",
    "unsafe_path": "La ruta de datos guardados no es segura",
    "io_error": "No se pudieron leer los datos guardados",
}


def _persistence_error(error):
    error_code = getattr(error, "error_code", "state_unavailable")
    message = _PERSISTENCE_ERROR_MESSAGES.get(
        error_code, "La persistencia de Veilleuse no está disponible"
    )
    return {"error_code": error_code, "error": message}


def _failed_section(error, fields):
    result = dict(fields)
    result["available"] = False
    result.update(_persistence_error(error))
    return result


def _automation_status(module):
    fields = {
        "schedule_enabled": None,
        "snooze_until": None,
        "snoozed": False,
        "transition_seconds": None,
        "origin": "unknown",
        "last_applied": None,
        "schedule_disabled": None,
        "manual_override": None,
        "schedule_display": None,
        "schedule_period_applied": None,
    }
    try:
        state = module.read_state()
    except Exception as error:
        return _failed_section(error, fields)
    fields.update(
        {
            "available": True,
            "schedule_enabled": state["schedule_enabled"],
            "snooze_until": state["snooze_until"],
            "snoozed": state["snooze_until"] is not None and state["snooze_until"] > time.time(),
            "transition_seconds": state["transition_seconds"],
            "origin": state["origin"],
            "last_applied": state["last_applied"],
            "schedule_disabled": state["schedule_disabled"],
            "manual_override": state["manual_override"],
            "schedule_display": state["schedule_display"],
            "schedule_period_applied": state["schedule_period_applied"],
            "error_code": None,
            "error": None,
        }
    )
    return fields


def _native_apply_values(temperature, gamma):
    """Apply both native night-light registers and return the confirmed state."""
    temperature_state = _apply_temperature(temperature)
    if not temperature_state["available"] or temperature_state.get("error"):
        temperature_state["error_code"] = "temperature_readback_failed"
        return temperature_state
    gamma_state = _apply_gamma(gamma)
    if not gamma_state["available"] or gamma_state.get("error"):
        gamma_state["error_code"] = "gamma_readback_failed"
        return gamma_state
    return gamma_state


def _apply_focused_brightness(percent):
    """Apply an absolute brightness percentage to the focused monitor."""
    monitor = read_monitor_state().get("monitor")
    return apply_brightness(monitor, percent)


def _current_profile():
    schedule = schedule_get()
    if not schedule.get("available"):
        return {
            "available": False,
            "error_code": "schedule_unavailable",
            "error": schedule.get("error") or "El perfil de horario no está disponible",
        }
    period_value = schedule.get("period")
    if period_value == "day":
        if schedule.get("day_identity"):
            return {"available": True, "kind": "identity", "period": "day"}
        return {
            "available": True,
            "kind": "temperature",
            "temperature": schedule["day_temp"],
            "period": "day",
        }
    return {
        "available": True,
        "kind": "temperature",
        "temperature": schedule["night_temp"],
        "period": "night",
    }


def _automation_environment():
    module = _utility_module("automation_utils")
    state = _state_module()
    if module is None or state is None:
        return None, None
    return module, {
        "read_state": state.read_state,
        "update_state": state.update_state,
        "append_history": state.append_history,
        "read_nightlight": read_nightlight,
        "apply_values": _native_apply_values,
        "apply_natural": _apply_natural,
        "apply_brightness": _apply_focused_brightness,
        "current_profile": _current_profile,
        "token": lambda: None,
    }


def _preflight_check(name, ok, error_code=None, error=None):
    return {
        "name": name,
        "available": bool(ok),
        "ok": bool(ok),
        "error_code": error_code if not ok else None,
        "error": error if not ok else None,
    }


def _probe_failure(name, result):
    kind = getattr(result, "_veilleuse_error_kind", None)
    stderr = _text(getattr(result, "stderr", "")).strip()
    if kind == "missing_command" or result.returncode == 127:
        return "missing_command", f"Comando ausente: {name}"
    if kind == "timeout" or result.returncode == DEADLINE_EXIT_CODE:
        return "timeout", f"Tiempo de espera agotado: {name}"
    return "backend_unavailable", f"Backend no disponible: {name}"


def _run_preflight_probe(name, command):
    try:
        result = run_command(command, timeout=COMMAND_TIMEOUT)
    except Exception:
        return (
            _preflight_check(name, False, "backend_unavailable", f"Backend no disponible: {name}"),
            None,
        )
    if result.returncode == 0:
        return _preflight_check(name, True), result
    error_code, error = _probe_failure(name, result)
    return _preflight_check(name, False, error_code, error), result


def preflight(*, monitor_state=None, brightness=None, nightlight=None):
    """Perform bounded, read-only helper/backend availability checks."""
    helper_path = Path(os.path.abspath(__file__))
    executable = helper_path.is_file() and os.access(helper_path, os.X_OK)
    helper = {
        "name": "helper",
        "path": str(helper_path),
        "executable": executable,
        "available": executable,
        "ok": executable,
        "error_code": None if executable else "not_executable",
        "error": None if executable else "El helper no es ejecutable",
    }

    if monitor_state is None:
        monitor_check, monitor_result = _run_preflight_probe(
            "omarchy-monitor-state", MONITOR_STATE_COMMAND
        )
        if monitor_check["ok"] and monitor_result is not None:
            lines = _text(monitor_result.stdout).splitlines()
            while len(lines) < 8:
                lines.append("")
            monitor_state = {"monitor": lines[5].strip() or None}
    else:
        monitor_check = _preflight_check(
            "omarchy-monitor-state",
            bool(monitor_state.get("monitor")),
            None if monitor_state.get("monitor") else "backend_unavailable",
            None if monitor_state.get("monitor") else "Backend no disponible: omarchy-monitor-state",
        )

    monitor_name = monitor_state.get("monitor") if isinstance(monitor_state, dict) else None
    if brightness is None:
        if monitor_name:
            brightness_check, _brightness_result = _run_preflight_probe(
                "omarchy-brightness-display",
                [*BRIGHTNESS_COMMAND, monitor_name],
            )
        else:
            if shutil.which(BRIGHTNESS_COMMAND[0]) is None:
                brightness_check = _preflight_check(
                    "omarchy-brightness-display",
                    False,
                    "missing_command",
                    "Comando ausente: omarchy-brightness-display",
                )
            else:
                brightness_check = _preflight_check(
                    "omarchy-brightness-display",
                    False,
                    "backend_unavailable",
                    "Backend no disponible: omarchy-brightness-display",
                )
    else:
        brightness_check = _preflight_check(
            "omarchy-brightness-display",
            brightness.get("available") is True,
            None if brightness.get("available") is True else "backend_unavailable",
            None if brightness.get("available") is True else "Backend no disponible: omarchy-brightness-display",
        )

    if nightlight is None:
        nightlight_check, _nightlight_result = _run_preflight_probe(
            "hyprctl/hyprsunset",
            [*HYPRSUNSET_COMMAND, "identity", "get"],
        )
    else:
        nightlight_check = _preflight_check(
            "hyprctl/hyprsunset",
            nightlight.get("available") is True,
            None if nightlight.get("available") is True else "backend_unavailable",
            None if nightlight.get("available") is True else "Backend no disponible: hyprctl/hyprsunset",
        )

    checks = [helper, monitor_check, brightness_check, nightlight_check]
    commands = {
        "omarchy-monitor-state": monitor_check,
        "omarchy-brightness-display": brightness_check,
        "hyprctl": nightlight_check,
    }
    backend = {
        "monitor": monitor_check,
        "brightness": brightness_check,
        "hyprsunset": nightlight_check,
    }
    return {
        "ok": all(check["ok"] for check in checks),
        "helper": helper,
        "commands": commands,
        "backend": backend,
        "checks": checks,
    }


def read_status(*, nightlight=None, monitor_name=None):
    """Combine monitor/brightness, nightlight and schedule state in one JSON."""
    monitor = read_monitor_state()
    brightness = None
    selected_monitor = monitor["monitor"] if monitor_name is None else monitor_name
    if selected_monitor:
        percent, error = read_brightness(selected_monitor)
        brightness_state = {
            "available": percent is not None,
            "percent": percent,
            "monitor": selected_monitor,
            "error": error,
        }
    else:
        brightness_state = {
            "available": False,
            "percent": None,
            "monitor": None,
            "error": "No se pudo resolver un monitor enfocado",
        }
    nightlight_state = nightlight if nightlight is not None else read_nightlight()
    module = _state_module()
    if module is None:
        state_error = RuntimeError("state_utils unavailable")
        automation = _failed_section(state_error, {
            "schedule_enabled": None,
            "snooze_until": None,
            "snoozed": False,
            "transition_seconds": None,
            "origin": "unknown",
            "last_applied": None,
            "schedule_disabled": None,
            "manual_override": None,
            "schedule_display": None,
            "schedule_period_applied": None,
        })
    else:
        automation = _automation_status(module)
    root = resolve_plugin_root()
    return {
        "plugin": {"id": PLUGIN_ID, "root": str(root)},
        "brightness": brightness_state,
        "nightlight": nightlight_state,
        "schedule": schedule_get(),
        "monitors": monitor["monitors"],
        "preflight": preflight(
            monitor_state=monitor,
            brightness=brightness_state,
            nightlight=nightlight_state,
        ),
        "automation": automation,
    }


def _emit(payload):
    json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


def _abort(message, error_code="invalid_argument"):
    _emit({"error": message, "error_code": error_code})
    return 1


def _bounded(value, minimum, maximum, label):
    try:
        integer = int(value)
    except (TypeError, ValueError):
        raise ValueError(f"{label} debe ser un número entero")
    if integer < minimum or integer > maximum:
        raise ValueError(f"{label} debe estar entre {minimum} y {maximum}")
    return integer


def cmd_status(_args):
    _emit(read_status())
    return 0


def cmd_preflight(_args):
    _emit(preflight())
    return 0


def _operation_success(result, *, monitor_name=None):
    payload = read_status(monitor_name=monitor_name)
    payload["ok"] = True
    payload["result"] = result
    if isinstance(result, dict) and result.get("operation"):
        payload["operation"] = result["operation"]
    return payload


def _operation_failure(error_code, error, *, result=None):
    payload = {
        "ok": False,
        "error_code": error_code,
        "error": str(error) if error else "La operación no se pudo completar",
    }
    if result is not None:
        payload["result"] = result
    try:
        payload["state"] = read_status()
    except Exception:
        pass
    return payload


def cmd_brightness(args):
    monitor_state = read_monitor_state()
    monitor, monitor_error = _resolve_monitor_target(args.monitor, monitor_state)
    if monitor_error:
        _emit(_operation_failure("monitor_unavailable", monitor_error))
        return 1
    if args.value is None:
        percent, error = read_brightness(monitor)
        _emit(
            {
                "available": percent is not None,
                "percent": percent,
                "monitor": monitor,
                "error": error,
            }
        )
        return 0 if percent is not None else 1
    try:
        raw = int(args.value)
    except (TypeError, ValueError):
        _emit(_operation_failure("invalid_argument", "El brillo debe ser un número entero"))
        return 1
    target = max(BRIGHTNESS_MIN, min(BRIGHTNESS_MAX, raw))
    state = apply_brightness(monitor, target)
    ok = state["available"] and state["error"] is None
    if ok:
        _emit(read_status(monitor_name=monitor))
    else:
        _emit(_operation_failure("brightness_readback_failed", state["error"], result=state))
    return 0 if ok else 1


def cmd_snooze(args):
    module, environment = _automation_environment()
    if module is None or environment is None:
        _emit(_operation_failure("helper_unavailable", "El automatizador no está disponible"))
        return 1
    try:
        if args.action == "status":
            result = module.snooze_status_current(environment)
        elif args.action == "set":
            if args.seconds is None and args.minutes is None:
                return _abort("snooze set requiere --seconds o --minutes")
            if args.seconds is not None and args.minutes is not None:
                return _abort("snooze set acepta solo uno de --seconds o --minutes")
            if args.seconds is not None:
                result = module.snooze_set_seconds(args.seconds, environment)
            else:
                result = module.snooze_set(args.minutes, environment)
        else:
            result = module.snooze_clear(environment)
        if not result.get("success", True):
            _emit(_operation_failure(result.get("error_code", "snooze_failed"), result.get("error"), result=result))
            return 1
        _emit(_operation_success(result))
        return 0
    except Exception as error:
        _emit(_operation_failure(getattr(error, "error_code", "snooze_failed"), error))
        return 1


def cmd_reconcile(_args):
    module, environment = _automation_environment()
    if module is None or environment is None:
        _emit(_operation_failure("helper_unavailable", "El automatizador no está disponible"))
        return 1
    result = module.reconcile(environment)
    if not result.get("success"):
        _emit(_operation_failure(result.get("error_code", "reconcile_failed"), result.get("error"), result=result))
        return 1
    _emit(_operation_success(result))
    return 0


def _persist_manual_intent(operation, values):
    """Record a successful manual nightlight operation as manual intent.

    Only the explicitly requested values are recorded (``None`` for
    toggle/natural).  The hardware change already succeeded, so a persistence
    failure must never mask it or turn the operation into an error; it is
    instead surfaced to the caller as a stable error code so the panel knows
    the schedule may still revert the manual setting.
    """
    module, environment = _automation_environment()
    if module is None or environment is None:
        return "state_unavailable"
    try:
        module.commit_manual_apply(environment, f"nightlight_{operation}", values)
    except Exception as error:
        return str(getattr(error, "error_code", "state_failed"))
    return None


def cmd_nightlight(args):
    operation = args.operation
    requested = None
    if operation == "toggle":
        state = toggle_nightlight()
    elif operation == "natural":
        state = _apply_natural()
    elif operation == "temperature":
        kelvin = _bounded(args.value, TEMPERATURE_MIN, TEMPERATURE_MAX, "La temperatura")
        state = _apply_temperature(kelvin)
        requested = {"temperature": kelvin}
    elif operation == "gamma":
        percent = _bounded(args.value, GAMMA_MIN, GAMMA_MAX, "La gamma")
        state = _apply_gamma(percent)
        requested = {"gamma": percent}
    else:
        return _abort(f"Operación de luz nocturna desconocida: {operation}")
    ok = state["available"] and state["error"] is None
    persist_error = None
    if ok:
        persist_error = _persist_manual_intent(operation, requested)
        run_command(["omarchy-shell", "-q", "nightlight", "refresh"])
    status = read_status(nightlight=state)
    if not ok:
        _emit({"error": state["error"], "error_code": "apply_failed", "state": status})
        return 1
    if persist_error:
        status["manual_persist_error"] = persist_error
    _emit(status)
    return 0


def _schedule_display_values(args):
    """Optional per-period display values (brightness/gamma) for the schedule."""
    display = {}
    for period in ("day", "night"):
        values = {}
        for field, minimum, maximum, label in (
            ("brightness", BRIGHTNESS_MIN, BRIGHTNESS_MAX, "brightness"),
            ("gamma", GAMMA_MIN, GAMMA_MAX, "gamma"),
        ):
            raw = getattr(args, f"{period}_{field}")
            if raw is None:
                continue
            values[field] = _bounded(raw, minimum, maximum, f"El {label} de {period}")
        if values:
            display[period] = values
    return display


def _persist_schedule_display(display):
    """Store the schedule's display values and arm them for the next reconcile.

    Clearing the applied-period marker makes the next reconcile treat the
    current period as fresh, so a just-saved schedule applies its brightness
    and gamma immediately instead of waiting for the next transition.
    """
    module = _state_module()
    if module is None:
        return "state_unavailable"
    try:
        module.update_state(
            lambda current: dict(
                current,
                schedule_display=display,
                schedule_period_applied=None,
            )
        )
    except Exception as error:
        return str(getattr(error, "error_code", "state_failed"))
    return None


def cmd_schedule(args):
    if args.action in ("status", "get"):
        if args.action == "status":
            toggle = _utility_module("schedule_toggle_utils")
            try:
                if toggle is not None and config_path().is_file():
                    toggle.HYPRSUNSET_CONFIG = config_path()
                    toggle_state = toggle.schedule_status(config_path())
                else:
                    toggle_state = _state_module().read_state()
                payload = read_status()
                payload["ok"] = True
                payload["result"] = {"operation": "schedule_status", **toggle_state}
                _emit(payload)
                return 0
            except Exception as error:
                _emit(_operation_failure(getattr(error, "error_code", "schedule_failed"), str(error)))
                return 1
        state = schedule_get()
        _emit(state)
        return 0 if state["available"] else 1
    if args.action in ("enable", "disable"):
        toggle = _utility_module("schedule_toggle_utils")
        if toggle is None:
            _emit(_operation_failure("helper_unavailable", "El gestor de horario no está disponible"))
            return 1
        try:
            toggle.HYPRSUNSET_CONFIG = config_path()
            operation = toggle.enable_schedule if args.action == "enable" else toggle.disable_schedule
            toggle_state = operation(config_path())
            payload = read_status()
            payload["ok"] = True
            payload["result"] = {"operation": f"schedule_{args.action}", **toggle_state}
            _emit(payload)
            return 0
        except Exception as error:
            _emit(_operation_failure(getattr(error, "error_code", "schedule_failed"), str(error)))
            return 1
    values = {
        "day_time": args.day_time,
        "day_temp": args.day_temp,
        "night_time": args.night_time,
        "night_temp": args.night_temp,
    }
    try:
        values["day_time"] = _clock(args.day_time, "Hora diurna")
        values["night_time"] = _clock(args.night_time, "Hora nocturna")
        values["day_temp"] = _bounded(args.day_temp, 5900, 6500, "Temperatura diurna")
        values["night_temp"] = _bounded(args.night_temp, 2500, 5000, "Temperatura nocturna")
        display = _schedule_display_values(args)
    except ValueError as error:
        return _abort(str(error))
    # A day temperature at or above identity reads as "natural color": write
    # the day profile as identity = true instead of a numeric temperature.
    values["natural_day"] = values["day_temp"] >= IDENTITY_TEMPERATURE
    state = schedule_set(values)
    ok = state["available"] and state["error"] is None
    if ok:
        persist_error = _persist_schedule_display(display)
        payload = read_status()
        if persist_error:
            payload["state_persist_error"] = persist_error
        _emit(payload)
        return 0
    _emit(
        {"error": state["error"], "error_code": "schedule_failed", "state": read_status()}
    )
    return 0 if ok else 1


def cmd_shortcut(args):
    """Status / install / remove for the optional Hyprland key shortcut.

    The command surface only edits the unique Veilleuse marker block in
    ``$XDG_CONFIG_HOME/hypr/bindings.lua`` (see shortcut_utils) and never
    installs anything automatically; ``status`` and ``remove`` are read/clean
    operations, and ``install`` requires an explicit ``--keys`` argument.
    """
    module = _shortcut_module()
    if module is None:
        return _abort("El gestor de atajos del plugin no está disponible")
    if args.action == "status":
        _emit(module.shortcut_status())
        return 0
    if args.action == "remove":
        result = module.remove_shortcut()
    else:
        result = module.install_shortcut(args.keys)
    ok = result.get("available") and result.get("error") is None
    if ok:
        _emit(result)
        return 0
    _emit(
        {
            "error": result.get("error") or "No se pudo gestionar el atajo",
            "error_code": "shortcut_failed",
            "state": module.shortcut_status(),
        }
    )
    return 1


def _clock(value, label):
    match = re.fullmatch(r"\s*([0-9]{1,2}):([0-9]{2})\s*", str(value))
    if not match:
        raise ValueError(f"{label} debe usar el formato HH:MM")
    hour, minute = map(int, match.groups())
    if hour > 23 or minute > 59:
        raise ValueError(f"{label} está fuera de rango")
    return f"{hour:02d}:{minute:02d}"


def build_parser():
    parser = argparse.ArgumentParser(
        prog="veilleuse-control",
        description="Veilleuse Omarchy 4 plugin control helper.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    status = subparsers.add_parser("status", help="Print combined status JSON")
    status.set_defaults(handler=cmd_status)

    preflight_parser = subparsers.add_parser(
        "preflight", help="Check helper and backend availability"
    )
    preflight_parser.set_defaults(handler=cmd_preflight)

    brightness = subparsers.add_parser(
        "brightness", help="Read or set display brightness (1-100)"
    )
    brightness.add_argument("value", nargs="?", type=str, help="Target brightness percentage")
    brightness.add_argument("--monitor", default="focused", help="focused or an enabled monitor name")
    brightness.set_defaults(handler=cmd_brightness)

    nightlight = subparsers.add_parser(
        "nightlight", help="Control the hyprsunset night light"
    )
    nightlight.add_argument(
        "operation",
        choices=("toggle", "natural", "temperature", "gamma"),
        help="Operation to run",
    )
    nightlight.add_argument("value", nargs="?", type=str, help="Target temperature/gamma")
    nightlight.set_defaults(handler=cmd_nightlight)

    snooze = subparsers.add_parser("snooze", help="Manage natural-light snooze")
    snooze_sub = snooze.add_subparsers(dest="action", required=True)
    snooze_status_parser = snooze_sub.add_parser("status", help="Show snooze status")
    snooze_status_parser.set_defaults(handler=cmd_snooze)
    snooze_set_parser = snooze_sub.add_parser("set", help="Snooze for a duration")
    snooze_set_parser.add_argument(
        "--seconds", type=int, help="Snooze seconds (10..86400), alternative to --minutes"
    )
    snooze_set_parser.add_argument(
        "--minutes", type=int, help="Snooze minutes (1..1440), alternative to --seconds"
    )
    snooze_set_parser.set_defaults(handler=cmd_snooze)
    snooze_clear_parser = snooze_sub.add_parser("clear", help="Clear snooze")
    snooze_clear_parser.set_defaults(handler=cmd_snooze)

    reconcile = subparsers.add_parser("reconcile", help="Reconcile snooze and schedule")
    reconcile.set_defaults(handler=cmd_reconcile)

    schedule = subparsers.add_parser("schedule", help="Get or set the hyprsunset schedule")
    schedule_sub = schedule.add_subparsers(dest="action", required=True)
    schedule_status_parser = schedule_sub.add_parser("status", help="Show schedule and toggle status")
    schedule_status_parser.set_defaults(handler=cmd_schedule)
    schedule_get_parser = schedule_sub.add_parser("get", help="Print the parsed schedule")
    schedule_get_parser.set_defaults(handler=cmd_schedule)
    schedule_enable_parser = schedule_sub.add_parser("enable", help="Restore the managed schedule profiles")
    schedule_enable_parser.set_defaults(handler=cmd_schedule)
    schedule_disable_parser = schedule_sub.add_parser("disable", help="Remove the managed schedule profiles")
    schedule_disable_parser.set_defaults(handler=cmd_schedule)
    schedule_set_parser = schedule_sub.add_parser("set", help="Atomically update the schedule")
    schedule_set_parser.add_argument("--day-time", required=True)
    schedule_set_parser.add_argument("--night-time", required=True)
    schedule_set_parser.add_argument("--day-temp", required=True, type=int)
    schedule_set_parser.add_argument("--night-temp", required=True, type=int)
    schedule_set_parser.add_argument("--day-brightness", type=int)
    schedule_set_parser.add_argument("--day-gamma", type=int)
    schedule_set_parser.add_argument("--night-brightness", type=int)
    schedule_set_parser.add_argument("--night-gamma", type=int)
    schedule_set_parser.set_defaults(handler=cmd_schedule)

    shortcut = subparsers.add_parser(
        "shortcut", help="Manage the optional key shortcut in user Hyprland bindings"
    )
    shortcut_sub = shortcut.add_subparsers(dest="action", required=True)
    shortcut_status_parser = shortcut_sub.add_parser("status", help="Show shortcut state")
    shortcut_status_parser.set_defaults(handler=cmd_shortcut)
    shortcut_install_parser = shortcut_sub.add_parser("install", help="Install the Veilleuse marker block")
    shortcut_install_parser.add_argument(
        "--keys",
        required=True,
        help='Key spec like "SUPER, V" (install is never automatic)',
    )
    shortcut_install_parser.set_defaults(handler=cmd_shortcut)
    shortcut_remove_parser = shortcut_sub.add_parser("remove", help="Remove the Veilleuse marker block")
    shortcut_remove_parser.set_defaults(handler=cmd_shortcut)
    return parser


def main(argv=None):
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return 2
    try:
        return args.handler(args)
    except (OSError, ValueError) as error:
        return _abort(str(error))


if __name__ == "__main__":
    raise SystemExit(main())
