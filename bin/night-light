#!/usr/bin/python3
"""Scriptable operator interface backed by hyprsunset_backend."""
from __future__ import annotations

import argparse
import importlib.util
import json
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

try:
    from schedule_utils import STATE_LOCK, exclusive_lock
except ModuleNotFoundError as error:
    if error.name != "schedule_utils":
        raise
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    from schedule_utils import STATE_LOCK, exclusive_lock

try:
    from hyprsunset_backend import (
        BackendState,
        ensure_backend,
        read_service_state,
        read_state as read_backend_state,
        reset_gamma,
        set_gamma,
        set_identity,
        set_temperature,
    )
except ModuleNotFoundError as error:
    if error.name != "hyprsunset_backend":
        raise
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    from hyprsunset_backend import (
        BackendState,
        ensure_backend,
        read_service_state,
        read_state as read_backend_state,
        reset_gamma,
        set_gamma,
        set_identity,
        set_temperature,
    )


def _load_status_module():
    path = Path(__file__).with_name("night-light-status")
    spec = importlib.util.spec_from_file_location(
        "night_light_status", path,
        loader=SourceFileLoader("night_light_status", str(path)),
    )
    if spec is None or spec.loader is None:
        raise ImportError("night-light-status")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


_status = _load_status_module()
build_payload = _status.build_payload
read_schedule = _status.read_schedule
build_status_payload = _status.build_status_payload


ERROR_UNAVAILABLE = "No se pudo conectar con hyprsunset"
ERROR_OPERATION = "No se pudo confirmar la operación"
ERROR_USAGE = "Selecciona una operación"


class _ArgumentParser(argparse.ArgumentParser):
    def error(self, _message):
        self.exit(2, f"{ERROR_USAGE}\n")


def _parser() -> argparse.ArgumentParser:
    parser = _ArgumentParser(prog="night-light")
    operations = parser.add_mutually_exclusive_group(required=True)
    operations.add_argument("--status", action="store_true")
    operations.add_argument("--temperature", type=int, metavar="K")
    operations.add_argument("--gamma", type=int, metavar="PERCENT")
    operations.add_argument("--natural", action="store_true")
    operations.add_argument("--reset-gamma", action="store_true")
    operations.add_argument("--cycle", action="store_true")
    return parser


def _failure(message: str) -> int:
    print(message, file=sys.stderr)
    return 1


def _apply(state: BackendState, operation) -> int:
    if state.active is None:
        return _failure(ERROR_UNAVAILABLE)
    try:
        result = operation()
    except (TypeError, ValueError):
        return _failure(ERROR_OPERATION)
    if result.returncode != 0:
        return _failure(ERROR_OPERATION)
    return 0


def _cycle_operation(state: BackendState):
    """Return the next quick mode from observed state, not saved preferences."""
    if state.identity is True:
        return set_temperature, 2700
    if state.active and state.temperature is not None:
        if abs(state.temperature - 2700) <= 50:
            return set_temperature, 3500
        if abs(state.temperature - 3500) <= 50:
            return set_temperature, 4200
        if abs(state.temperature - 4200) <= 50:
            return set_identity, None
    return set_temperature, 2700


def main(argv=None) -> int:
    parser = _parser()
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return int(error.code)

    if args.status:
        with exclusive_lock(STATE_LOCK):
            payload = build_status_payload(acquire_lock=False)
        print(json.dumps(payload, ensure_ascii=False))
        return 0

    with exclusive_lock(STATE_LOCK):
        state = ensure_backend()
        if args.temperature is not None:
            return _apply(state, lambda: set_temperature(args.temperature))
        if args.gamma is not None:
            return _apply(state, lambda: set_gamma(args.gamma))
        if args.natural:
            return _apply(state, set_identity)
        if args.reset_gamma:
            return _apply(state, reset_gamma)
        if args.cycle:
            setter, value = _cycle_operation(state)
            operation = setter if value is None else lambda: setter(value)
            return _apply(state, operation)
    return parser.error(ERROR_USAGE)


if __name__ == "__main__":
    raise SystemExit(main())
