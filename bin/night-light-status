#!/usr/bin/python3
import json
import sys
from pathlib import Path

try:
    from schedule_utils import (
        DAY_TEMP,
        HYPRSUNSET_CONFIG,
        STATE_LOCK,
        exclusive_lock,
        parse_schedule_text,
    )
except ModuleNotFoundError as error:
    if error.name != "schedule_utils":
        raise
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    from schedule_utils import (
        DAY_TEMP,
        HYPRSUNSET_CONFIG,
        STATE_LOCK,
        exclusive_lock,
        parse_schedule_text,
    )

try:
    from hyprsunset_backend import (
        BackendState,
        ServiceState,
        read_service_state,
        read_state,
    )
except ModuleNotFoundError as error:
    if error.name != "hyprsunset_backend":
        raise
    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
    from hyprsunset_backend import (
        BackendState,
        ServiceState,
        read_service_state,
        read_state,
    )


SCHEDULE = HYPRSUNSET_CONFIG


def read_schedule():
    try:
        schedule = parse_schedule_text(SCHEDULE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        schedule = parse_schedule_text("")
    return schedule["night_time"], schedule["day_time"]


def service_hint(service: ServiceState) -> str:
    details = []
    if service.active is False:
        details.append("Servicio detenido")
    elif service.active is True:
        details.append("Servicio activo")
    if service.enabled is False:
        details.append("no habilitado al iniciar sesión")
    elif service.enabled is True:
        details.append("habilitado al iniciar sesión")
    return " · ".join(details)


def build_payload(
    state: BackendState,
    service: ServiceState,
    night_time: str,
    day_time: str,
):
    if not state.available or state.active is None:
        hint = service_hint(service)
        tooltip = "Luz nocturna no disponible\nNo se pudo conectar con hyprsunset"
        if hint:
            tooltip += f"\n{hint}"
        return {
            "text": "No disponible",
            "tooltip": tooltip,
            "class": "unavailable",
            "alt": "unavailable",
        }
    if state.identity is True:
        return {
            "text": "Natural",
            "tooltip": (
                f"Color natural\n{night_time} → {day_time}"
                "\n\nClic: cambiar modo\nClic central: abrir controles"
            ),
            "class": "inactive",
            "alt": "inactive",
        }
    if state.active:
        temperature = "No disponible" if state.temperature is None else f"{state.temperature} K"
        return {
            "text": temperature,
            "tooltip": (
                f"Luz nocturna activa · {temperature}\n{night_time} → {day_time}"
                "\n\nClic: cambiar modo\nClic central: abrir controles"
            ),
            "class": "active",
            "alt": "active",
        }
    return {
        "text": "Off",
        "tooltip": (
            f"Luz nocturna apagada\nSe activará a las {night_time}"
            "\n\nClic: cambiar modo\nClic central: abrir controles"
        ),
        "class": "inactive",
        "alt": "inactive",
    }


def _build_status_payload():
    state = read_state()
    # systemd is diagnostic only; a manually started hyprsunset must still work.
    service = read_service_state()
    night_time, day_time = read_schedule()
    return build_payload(state, service, night_time, day_time)


def build_status_payload(*, acquire_lock: bool = True):
    """Build one coherent Waybar snapshot, optionally reusing a held lock."""
    if not acquire_lock:
        return _build_status_payload()
    with exclusive_lock(STATE_LOCK):
        return _build_status_payload()


def main() -> int:
    print(json.dumps(build_status_payload(), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
